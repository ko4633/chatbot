# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omnis
POSTGRES_USER=omnis
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO / raw data lake ---
# Set RAW_STORE_BACKEND=local to skip MinIO entirely for local dev/tests.
RAW_STORE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=omnis
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=omnis-raw
MINIO_SECURE=false

# --- AI ---
# Leave AI_ENABLED=false (or ANTHROPIC_API_KEY empty) to run fully in
# deterministic AI_DISABLED mode. The system must boot and serve all
# non-AI functionality either way.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# --- API / Web ---
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
