# 쿠팡윙(Wing) 판매자센터 > 오픈API 관리에서 발급받은 값을 입력하세요.
# https://wing.coupang.com > 판매자정보 > 오픈API 관리

COUPANG_ACCESS_KEY=여기에_ACCESS_KEY_입력
COUPANG_SECRET_KEY=여기에_SECRET_KEY_입력
COUPANG_VENDOR_ID=A00000000

# 반품지 / 출고지 코드 (쿠팡윙 > 판매자정보 에서 확인, 기본값으로 사용됨)
DEFAULT_RETURN_CENTER_CODE=
DEFAULT_OUTBOUND_SHIPPING_PLACE_CODE=

# 실제 운영 API가 아닌 개발계(sandbox)를 쓰려면 아래 주소로 바꾸세요. (쿠팡에서 별도 발급)
COUPANG_API_BASE_URL=https://api-gateway.coupang.com
